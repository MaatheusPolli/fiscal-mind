{
  "name": "fiscal-mind",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d db",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "eval": "tsx scripts/eval.ts",
    "dev:api": "pnpm --filter @fiscal-mind/api dev",
    "dev:web": "pnpm --filter @fiscal-mind/web dev",
    "reindex": "tsx --env-file=.env scripts/reindex.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.0",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "pdfjs-dist": "4",
    "pg": "^8.23.0"
  }
}
